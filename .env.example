# ==========================================
# DesaSmart Environment Configuration Example
# Copy this file to .env and fill in your values
# ==========================================

# Database Configuration (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# Authentication & Security (Min. 32 characters)
JWT_SECRET="your-super-secure-jwt-secret-key-32-characters-min"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Provider Configuration (groq | rule)
AI_PROVIDER="rule"
GROQ_API_KEY=""

# WhatsApp Notification Gateway (Fonnte API)
FONNTE_API_KEY=""

# SMTP Email Configuration (Gmail App Password / Mailtrap)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="DesaSmart Silihasih <noreply@desasmart.id>"
